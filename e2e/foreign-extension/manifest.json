{
  "manifest_version": 3,
  "name": "NDS e2e foreign frame",
  "description": "Test fixture: injects its own page as an iframe, like a password manager's inline menu.",
  "version": "1.0",
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["inject.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{ "resources": ["frame.html"], "matches": ["<all_urls>"] }]
}
